{
  "manifest_version": 3,
  "name": "Codeforces Comfy Theme",
  "version": "0.3.0",
  "description": "Improves Codeforces readability with a soft pastel theme, Japanese labels for common UI text, and an inline submit panel.",
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*",
        "https://*.codeforces.com/*"
      ],
      "css": ["theme.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://codeforces.com/*",
        "https://*.codeforces.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["theme.css"],
      "matches": [
        "https://codeforces.com/*",
        "https://*.codeforces.com/*"
      ]
    }
  ]
}
