{
  "manifest_version": 3,
  "name": "AtCoder Sample Visualizer",
  "version": "1.0.0",
  "description": "サンプル入力を点群または(頂点・辺)グラフとして解釈できたときに、座標平面上に描画するボタンを追加します。",
  "content_scripts": [
    {
      "matches": [
        "https://atcoder.jp/contests/*/tasks/*",
        "https://*.contest.atcoder.jp/tasks/*",
        "http://*.contest.atcoder.jp/tasks/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
